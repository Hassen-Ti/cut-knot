{
  "name": "cut-knot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "Hassen-Ti",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --no-sandbox --disable-dev-shm-usage\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist:win": "tsc -b && ELECTRON=1 vite build && npm run build:electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win zip --x64 --publish never",
    "test:electron": "npm run build:electron && ELECTRON=1 vite build && node scripts/electron-smoke.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.2",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "app.cutknot.desktop",
    "productName": "Cut Knot",
    "copyright": "Copyright 2026 Hassen-Ti",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.cjs",
      "!**/node_modules/**"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "publish": null
  },
  "license": "Apache-2.0",
  "description": "Cut Knot — Cut. Knot. Done. 10% Excel + 10% board. Spatial data atelier (Source → Board)."
}
